{
  "name": "seams-docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Astro Starlight documentation site for the Seams gem. Content is synced from ../doc and ../README.md at build time (no file moves).",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "assets": "node scripts/og-image.mjs",
    "prebuild": "npm run sync",
    "predev": "npm run sync",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/starlight": "^0.41.10",
    "astro": "^7.0.6",
    "astro-og-canvas": "^0.13.0",
    "sharp": "^0.35.3",
    "unist-util-visit": "^5.1.0"
  }
}
